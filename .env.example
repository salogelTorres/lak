# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to talk to the bot.
# Leave empty to allow anyone who finds the bot.
ALLOWED_USER_IDS=

# --- Agent identity ---
AGENT_NAME=Assistant
SYSTEM_PROMPT_FILE=app/prompts/system_prompt.txt

# IANA timezone (e.g. Europe/Madrid, America/New_York) used to tell the
# model the current date and time on every message, so it's always
# accurate — never baked once into the prompt and left to go stale.
TZ=UTC

# Rough token budget for how much conversation history gets sent to the
# model on each message (~4 chars/token estimate, not an exact count).
# Keep this comfortably under your model's context window, minus room for
# its reply: Ollama's default is 4096 tokens total, shared with the system
# prompt and the response.
MAX_HISTORY_TOKENS=3000

# How much of that budget (the most recent messages) is always sent
# verbatim. Anything older than that, once the budget above is exceeded,
# is compacted into a running summary via an extra LLM call instead of
# being dropped outright — so old context is condensed, not lost. Must be
# smaller than MAX_HISTORY_TOKENS.
RECENT_HISTORY_TOKENS=500

# --- LLM backend: "ollama" (local model) or "cloud" (any OpenAI-compatible API) ---
LLM_BACKEND=ollama

# Ollama (local model, no API key needed). Runs as its own service in
# docker-compose.yml, reachable at http://ollama:11434 over the Compose
# network — no need to install Ollama on the host.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# Cloud backend: works with OpenAI, OpenRouter, or any other service that
# exposes an OpenAI-compatible /chat/completions endpoint.
CLOUD_API_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=gpt-4o-mini

# --- Tools ---
# Comma-separated list of tools this agent is allowed to call mid-conversation.
# Tools are catalogued in app/tools/ independently of any agent — nothing is
# enabled by default; list the ones you want here. Unknown names are ignored.
# Requires a model that supports tool/function calling (qwen3:8b and most
# cloud models do; check yours if tool calls seem to be ignored).
#
# Available: search_web (DuckDuckGo, no API key needed)
ENABLED_TOOLS=

# --- Voice messages ---
# Whisper model (faster-whisper) used to transcribe Telegram voice notes,
# runs locally in the bot container on CPU, independent of LLM_BACKEND.
# tiny/base = faster, less accurate. small = good default balance.
# medium/large-v3 = more accurate, slower and more RAM.
WHISPER_MODEL=small
